{
  "lastChangelogVersion": "1.2.0",
  "theme": "ansi-dark",
  "defaultProvider": "github-copilot",
  "defaultModel": "gpt-6-luna",
  "defaultThinkingLevel": "medium",
  "packages": [
    "npm:pi-context-view",
    {
      "source": "npm:@ff-labs/pi-fff",
      "extensions": [
        "+src/index.ts"
      ]
    },
    {
      "source": "npm:pi-mcp-adapter",
      "extensions": [
        "-index.ts"
      ],
      "skills": [
        "+skills/mcp-scripting/SKILL.md"
      ]
    },
    "npm:pi-web-access"
  ],
  "enableInstallTelemetry": false,
  "treeFilterMode": "default",
  "skills": [],
  "showHardwareCursor": false,
  "enableSkillCommands": true,
  "compaction": {
    "enabled": true
  },
  "editorPaddingX": 0,
  "extensions": [
    "+extensions/startup/index.ts",
    "+extensions/styled-outputs/index.ts"
  ]
}